# 复制到云函数"加密环境变量"里填写;真实值绝不进仓库。
STATE_STORE=redis
REDIS_URL=
BEICHEN_REDIS_PREFIX=beichen:v27
# 如果不用 REDIS_URL，也可以分别填写 REDIS_HOST/REDIS_PORT/REDIS_USERNAME/REDIS_PASSWORD/REDIS_TLS。
# REDIS_CONNECT_TIMEOUT_MS=3000

QIANFAN_API_KEY=
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2/tokenplan/personal
QIANFAN_MODEL=qianfan-code-latest
GATE_TOTP_SECRET=
GATE_SESSION_SECRET=
CORS_ALLOWED_ORIGINS=https://yusheng266186-beep.github.io
PORT=9000

# 可选调优项(默认即推荐值)
GATE_TOKEN_TTL_MS=604800000
UPSTREAM_TIMEOUT_MS=540000
# 日常请求上限。正式页面日常请求是 5000；10000 及以上由服务端视为星图请求。
# NORMAL_MAX_TOKENS=5000
# MAX_SESSION_TURNS=300（单会话终身聊天轮数上限，可调范围 20-5000，超限返回 409）
# REPORT_ATTEMPTS=6（每次验证的星图上游尝试总数上限）
# REPORT_REPAIR_ATTEMPTS=2（同一张待确认星图允许的修复尝试数）
# TURN_LEASE_MS=600000（普通请求预占最长保留时间）
# REPORT_LEASE_MS=600000（星图请求预占最长保留时间）
# QIANFAN_THINKING_BUDGET=2048（日常轮）
# QIANFAN_REPORT_THINKING_BUDGET=4096（星图轮）
